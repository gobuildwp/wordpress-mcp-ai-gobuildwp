    "requires": {
        "php": "8.0",
        "wp": "6.9"
    },
    "categories": {
        "security-integrity": {
            "label": "Security integrity",
            "description": "Background scans that compare WordPress core, WordPress.org plugin and WordPress.org theme files against their published checksums, look for PHP in the uploads folder and for code patterns often left by attackers, and check the database and configuration for risky accounts, roles, URLs, injected scripts and settings. Scan results name files, rules and line numbers, or database rows by id and label, and never include file contents or stored values. Fixes for what a scan found (quarantine a file, restore a core file from WordPress.org, demote an administrator, unpublish a post) are separate, confirmed and undoable. A read-only check asks WordPress.org which installed plugins and themes it has closed, or that have had no release in over two years."
        }
    },
